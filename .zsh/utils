# Ctrl+W removes one path segment (until the previous /)
_backward_kill_to_slash() {
    local new_cursor=$((CURSOR - 1))
    while (( new_cursor > 0 )); do
        if [[ "${BUFFER[$new_cursor]}" == "/" || "${BUFFER[$new_cursor]}" == " " ]]; then
            BUFFER="${BUFFER[1,$new_cursor]}${BUFFER[$((CURSOR + 1)),-1]}"
            CURSOR=$new_cursor
            return
        fi
        new_cursor=$((new_cursor - 1))
    done
    # If no slash found, delete to the beginning
    BUFFER="${BUFFER[$((CURSOR + 1)),-1]}"
    CURSOR=0
}

zle -N _backward_kill_to_slash
bindkey '^W' _backward_kill_to_slash

# Ctrl+Arrow keys for path-aware word navigation (using / and space as separators)
_backward_to_slash() {
    local new_cursor=$((CURSOR - 1))
    while (( new_cursor > 0 )); do
        if [[ "${BUFFER[$new_cursor]}" == "/" || "${BUFFER[$new_cursor]}" == " " ]]; then
            CURSOR=$new_cursor
            return
        fi
        new_cursor=$((new_cursor - 1))
    done
    CURSOR=0
}

_forward_to_slash() {
    local new_cursor=$((CURSOR + 1))
    local len=$#BUFFER
    while (( new_cursor < len )); do
        if [[ "${BUFFER[$new_cursor]}" == "/" || "${BUFFER[$new_cursor]}" == " " ]]; then
            CURSOR=$new_cursor
            return
        fi
        new_cursor=$((new_cursor + 1))
    done
    CURSOR=$len
}

zle -N _backward_to_slash
zle -N _forward_to_slash

bindkey '^[[1;5D' _backward_to_slash
bindkey '^[[1;5C' _forward_to_slash


