# Appearance
theme = Mariana
background = #2E3842
confirm-close-surface = always
window-decoration = server
window-theme = ghostty
cursor-style = block
cursor-style-blink = false
window-padding-y = 0
window-padding-balance = true
#window-padding-color = background
unfocused-split-opacity = 0.92

unfocused-split-fill = #eeeeee
split-divider-color = #ff0000


# GTK
gtk-custom-css = custom.css
gtk-titlebar = false
gtk-opengl-debug = false
#gtk-wide-tabs = false
#adw-toolbar-style = raised-border

# Clipboard
clipboard-trim-trailing-spaces = true
clipboard-paste-bracketed-safe = true
copy-on-select = false
clipboard-paste-protection = false

# Font
font-family = "VictorMono Nerd Font"
font-style = "SemiBold"
font-family = "VictorMono Nerd Font"
font-style-bold = "Bold"
font-family = "VictorMono Nerd Font"
font-style-italic = "SemiBold Italic"
font-family = "VictorMono Nerd Font"
font-style-bold-italic = "Bold Italic"
font-size = 11

# Misc
confirm-close-surface = false
shell-integration-features = no-cursor
app-notifications = no-clipboard-copy
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 10m

# keybinds in case ghostty adds sessions saving
# so i can potentially ditch tmux
keybind = ctrl+a>n=new_tab
keybind = alt+shift+h=previous_tab
keybind = alt+shift+l=next_tab
keybind = ctrl+a>ctrl+shift+l=move_tab:1
keybind = ctrl+a>ctrl+shift+h=move_tab:-1
keybind = ctrl+shift+-=reload_config

keybind = ctrl+a>shift+2=new_split:down
keybind = ctrl+a>shift+5=new_split:right
keybind = alt+h=goto_split:left
keybind = alt+l=goto_split:right
keybind = alt+k=goto_split:up
keybind = alt+j=goto_split:down
keybind = ctrl+a>shift+0=equalize_splits
keybind = ctrl+a>ctrl+k=resize_split:up,75
keybind = ctrl+a>ctrl+j=resize_split:down,75
keybind = ctrl+a>ctrl+h=resize_split:left,75
keybind = ctrl+a>ctrl+l=resize_split:right,75

keybind = ctrl+a>x=close_surface

keybind = super+ctrl+r=prompt_surface_title


# Vim-mode keybindings

# Entry point
keybind = alt+v=activate_key_table:vim

# Key table definition
keybind = vim/

# Line movement
keybind = vim/j=scroll_page_lines:1
keybind = vim/k=scroll_page_lines:-1

# Page movement
keybind = vim/ctrl+d=scroll_page_down
keybind = vim/ctrl+u=scroll_page_up

# Jump to top/bottom
keybind = vim/g>g=scroll_to_top
keybind = vim/shift+g=scroll_to_bottom

# Search (if you want vim-style search entry)
keybind = vim/shift+7=start_search
keybind = vim/n=navigate_search:next

# Copy mode / selection
# Note we're missing a lot of actions here to make this more full featured.
keybind = vim/y>y=copy_to_clipboard

# Command Palette
keybind = vim/shift+period=toggle_command_palette

# Exit
keybind = vim/escape=deactivate_key_table
keybind = vim/i=deactivate_key_table

# Catch unbound keys
keybind = vim/catch_all=ignore
