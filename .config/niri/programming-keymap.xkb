xkb_keymap {
    xkb_keycodes { include "evdev+aliases(qwerty)" };
    xkb_types { include "complete" };
    xkb_compat { include "complete" };
    xkb_symbols {
        include "pc+de(mac_nodeadkeys)+de(mac_nodeadkeys):2+inet(evdev)+ctrl(swap_lalt_lctl_lwin)+level3(caps_switch)+kpdl(comma)"
        name[Group1] = "programming";

        key <AE09> { symbols[Group1] = [ 9, parenleft, braceleft, periodcentered ] };
        key <AE10> { symbols[Group1] = [ 0, parenright, braceright, macron ] };
        key <AE11> { symbols[Group1] = [ 0, equal, notequal, macron ] };
        key <AC02> {
            type[Group1] = "FOUR_LEVEL",
            symbols[Group1] = [ s, S, ssharp, U1E9E ]
        };
        key <AD11> {
			type[Group1] = "FOUR_LEVEL",
			symbols[Group1] = [ bracketleft, braceleft, diaeresis, VoidSymbol ]
		};
        key <AD12> { symbols[Group1] = [ bracketright, plus, asterisk, braceright ] };
        key <AC02> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ s, S, ssharp, U1E9E ] };
        key <AC10> {
			type[Group1] = "FOUR_LEVEL",
			symbols[Group1] = [ semicolon, colon, oslash, Oslash ]
		};
        key <AC11> {
			type[Group1] = "FOUR_LEVEL",
			symbols[Group1] = [ apostrophe, quotedbl, aring, Aring ]
		};
        key <AC01> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ a, A, adiaeresis, Adiaeresis ] };
        key <AD07> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ u, U, udiaeresis, Udiaeresis ] };
        key <AD09> { type[Group1] = "FOUR_LEVEL", symbols[Group1] = [ o, O, odiaeresis, Odiaeresis ] };
        key <BKSL> { symbols[Group1] = [ numbersign, slash, bar, backslash ] };
        key <AB10> { symbols[Group1] = [ minus, underscore, question, emdash ] };
    };
};
