input {
	mod-key "Super"
	keyboard {
		xkb {
			layout "de"
			variant "mac_nodeadkeys"
			options "ctrl:swap_lalt_lctl_lwin,lv3:caps_switch,compose:caps,kpdl:comma"
			// apple keyboard
			//options "ctrl:swap_lwin_lctl,lv3:caps_switch,compose:caps"
			//options "lv3:caps_switch,compose:caps"
		}

		numlock
	}

	touchpad {
		tap
		dwt
		dwtp
		drag true
		// drag-lock
		// natural-scroll
		accel-speed 0.2
		accel-profile "flat"
		// scroll-method "two-finger"
		// disabled-on-external-mouse
	}

	mouse {
		// off
		accel-speed -0.5
		accel-profile "flat"
	}
}

// Kanshi handles monitor stuff, this is just here as a fallback if
// something happens to kanshi (god forbid...)

/-output "eDP-1" {
	off
	mode "2560x1440@165.003"
	scale 1.12
	position x=0 y=0
}

output "DP-3" {
	focus-at-startup
	position x=0 y=0
}

output "HDMI-A-1" {
	position x=0 y=1080
}

// https://github.com/YaLTeR/niri/wiki/Configuration:-Layout
layout {
	gaps 12

	center-focused-column "never"
	always-center-single-column

	empty-workspace-above-first

	tab-indicator {
		length total-proportion=0.5
		corner-radius 10
		active-color "#990000"
		inactive-color "gray"
		urgent-color "blue"
		gap 0
	}

	preset-column-widths {
		proportion 0.33333
		proportion 0.5
		proportion 0.66667
	}

	focus-ring {
		width 2
		inactive-color "rgba(0, 0, 0, 0)"
		active-gradient from="#00d4ff" to="#fff239" angle=45
	}

	border {
		width 1
		active-color "rgba(0, 0, 0, 0)"
		inactive-color "rgba(255, 255, 255, 0.25)"
		urgent-color "#9b0000"
	}

	shadow {
		on
		draw-behind-window true
		offset x=0 y=0
		softness 25
		spread 0
		color "#0005"
	}

	struts {
		left 24
		right 24
		top -2
		bottom -2
	}
}

window-rule {
	geometry-corner-radius 10
	clip-to-geometry true
	draw-border-with-background true

	background-effect {
		blur true
		noise 0.05
		saturation 3
	}
}

hotkey-overlay {
	skip-at-startup
}

gestures {
	hot-corners {
		off
	}
}

cursor {
	xcursor-theme "Vimix-cursors"
	hide-when-typing
}

spawn-at-startup "xwayland-satellite"
spawn-at-startup "kwalletd6"
spawn-at-startup "mako"
spawn-sh-at-startup "bbclipd --max-entries=200"
spawn-sh-at-startup "owncloud --quite"
spawn-sh-at-startup "~/.config/niri/niri-tilemod -n 2 -b 0 100 --solo_first_column"

environment {
	ELECTRON_OZONE_PLATFORM_HINT "auto"
	XDG_MENU_PREFIX "niri-"
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
	slowdown 0.6
}

window-rule {
	match app-id=r#"^one\.alynx\.showmethekey$"# title="^Floating Window - Show Me The Key$"
	open-floating true
}

window-rule {
	match app-id=r#"^showmethekey-gtk$"#
	open-floating true
}

window-rule {
	match app-id=r#"^org.kde.kcalc$"#
	open-floating true
}

window-rule {
	match app-id=r#"qjackctl$"#
	open-floating true
}

window-rule {
	match app-id=r#"firefox$"# title="^Picture-in-Picture$"
	open-floating true
}

window-rule {
	match app-id=r#""# title="^Picture in picture$"
	open-floating true
}

window-rule {
	match app-id=r#"love-"#
	open-floating true
}

window-rule {
	match app-id=r#"^org\.keepassxc\.KeePassXC$"#
	match app-id=r#"^org\.gnome\.World\.Secrets$"#
	block-out-from "screen-capture"
}


binds {
	Mod+Shift+Slash { show-hotkey-overlay; }

	Ctrl+Space { spawn "~/.config/rofi/scripts/launcher_t7"; }
	Mod+Ctrl+Alt+C { spawn "wl-color-picker"; }
	Ctrl+Alt+C { spawn "wl-color-picker" "clipboard"; }
	Ctrl+Shift+X { spawn "bbclip"; }

	Mod+N { spawn "~/.config/niri/toggle-ironbar.sh"; }

	Mod+T {
		spawn "ghostty" "+new-window";
	}

	Mod+Ctrl+T {
		spawn "ghostty" "+new-window" "--title=niri-tile";
	}

	Mod+Ctrl+C {
		spawn "ghostty" "+new-window" "--title=niri-column";
	}

	Mod+Ctrl+S {
		spawn "ghostty" "+new-window" "--title=niri-stack";
	}

	Mod+P hotkey-overlay-title="Open a Terminal: ghostty" {
		spawn "ghostty" "+toggle-quick-terminal";
	}

	Mod+B {
		spawn-sh "touch \"$XDG_RUNTIME_DIR/niri-tilemod-force-stack-vivaldi\";
			exec vivaldi-stable --password-store=kwallet6
				--ozone-platform=wayland
				--new-window";
	}

	Mod+Ctrl+B {
		spawn-sh "touch \"$XDG_RUNTIME_DIR/niri-tilemod-force-column-vivaldi\";
			exec vivaldi-stable --password-store=kwallet6
				--ozone-platform=wayland
				--new-window";
	}

	// --- Volume internal - tuxedo
	//XF86AudioRaiseVolume allow-when-locked=true {
	//	spawn "wpctl" "set-volume" "@DEFAULT_SINK@" "5%+"
	//}
	//XF86AudioLowerVolume allow-when-locked=true {
	//	spawn "wpctl" "set-volume" "@DEFAULT_SINK@" "5%-"
	//}
	XF86AudioMute allow-when-locked=true {
		spawn "wpctl" "set-mute" "@DEFAULT_SINK@" "toggle";
	}

	XF86AudioMicMute allow-when-locked=true {
		spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle";
	}

	// --- Volume Desktop sink
	XF86AudioRaiseVolume allow-when-locked=true {
		spawn "~/.config/niri/niri-volume.sh" "@DEFAULT_SINK@" "up";
	}
	XF86AudioLowerVolume allow-when-locked=true {
		spawn "~/.config/niri/niri-volume.sh" "@DEFAULT_SINK@" "down";
	}

	// --- Volume BGM sink
	Mod+XF86AudioRaiseVolume allow-when-locked=true {
		spawn "~/.config/niri/niri-volume.sh" "jack_out.3" "up";
	}
	Mod+XF86AudioLowerVolume allow-when-locked=true {
		spawn "~/.config/niri/niri-volume.sh" "jack_out.3" "down";
	}
	Mod+XF86AudioMute        allow-when-locked=true {
		spawn "pactl" "set-sink-mute" "jack_out.3" "toggle";
	}
	// --- Media keys
	XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
	XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
	XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }

	// --- BRIGTHNESS LAPTOP
	XF86MonBrightnessUp allow-when-locked=true {
		spawn "brightnessctl" "s" "10%+";
	}
	XF86MonBrightnessDown allow-when-locked=true {
		spawn "brightnessctl" "s" "10%-";
	}

	// --- BRIGTHNESS MONITOR 1
	Mod+XF86MonBrightnessUp allow-when-locked=true {
		spawn "~/.config/niri/niri-brightness.sh" "i2c-0" "up";
	}
	Mod+XF86MonBrightnessDown allow-when-locked=true {
		spawn "~/.config/niri/niri-brightness.sh" "i2c-0" "down";
	}

	// --- BRIGTHNESS MONITOR 2
	Mod+Ctrl+XF86MonBrightnessUp allow-when-locked=true {
		spawn "~/.config/niri/niri-brightness.sh" "i2c-2" "up";
	}
	Mod+Ctrl+XF86MonBrightnessDown allow-when-locked=true {
		spawn "~/.config/niri/niri-brightness.sh" "i2c-2" "down";
	}

	Mod+O repeat=false { toggle-overview; }
	Mod+Q repeat=false { spawn-sh "~/.config/niri/niri-smart-close.sh"; }

	Mod+H    { spawn-sh "~/.config/niri/niri-focus-column-row.sh left"; }
	Mod+J    { focus-window-or-monitor-down; }
	Mod+K    { focus-window-or-monitor-up; }
	Mod+L    { spawn-sh "~/.config/niri/niri-focus-column-row.sh right"; }

	Mod+Alt+H     { move-column-left; }
	Mod+Shift+J   { move-window-down; }
	Mod+Shift+K   { move-window-up; }
	Mod+Alt+L     { move-column-right; }

	// move or swap selected window to the left column depending
	// on column row count
	Mod+Shift+H  { spawn-sh "~/.config/niri/niri-smart-move left"; }
	// move or swap selected window to the right column depending
	// on column row count
	Mod+Shift+L  { spawn-sh "~/.config/niri/niri-smart-move right"; }

	Ctrl+Shift+H     { focus-monitor-left; }
	Ctrl+Shift+J     { focus-monitor-down; }
	Ctrl+Shift+K     { focus-monitor-up; }
	Ctrl+Shift+L     { focus-monitor-right; }

	Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
	Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
	Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
	Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

	Mod+Ctrl+J            { focus-workspace-down; }
	Mod+Ctrl+K            { focus-workspace-up; }
	Mod+Ctrl+Page_Down    { move-column-to-workspace-down; }
	Mod+Ctrl+Page_Up      { move-column-to-workspace-up; }
	Mod+Ctrl+Shift+U      { move-column-to-workspace-down; }
	Mod+Ctrl+Shift+I      { move-column-to-workspace-up; }

	Mod+Shift+Page_Down { move-workspace-down; }
	Mod+Shift+Page_Up   { move-workspace-up; }
	Mod+Shift+U         { move-workspace-down; }
	Mod+Shift+I         { move-workspace-up; }

	Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
	Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
	Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
	Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

	Mod+WheelScrollRight      { focus-column-right; }
	Mod+WheelScrollLeft       { focus-column-left; }
	Mod+Ctrl+WheelScrollRight { move-column-right; }
	Mod+Ctrl+WheelScrollLeft  { move-column-left; }

	Mod+Shift+WheelScrollDown      { focus-column-right; }
	Mod+Shift+WheelScrollUp        { focus-column-left; }
	Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
	Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

	// The following binds move the focused window in and out of a column.
	// If the window is alone, they will consume it into the nearby column to the side.
	// If the window is already in a column, they will expel it out.
	Mod+Ctrl+H    { consume-or-expel-window-left; }
	Mod+Ctrl+L    { consume-or-expel-window-right; }

	// Consume one window from the right to the bottom of the focused column.
	Mod+Comma  { consume-window-into-column; }
	// Expel the bottom window from the focused column to the right.
	Mod+Period { expel-window-from-column; }

	Mod+R           { switch-preset-column-width; }
	Mod+Ctrl+R     { switch-preset-window-height; }
	Mod+Shift+R      { reset-window-height; }
	Ctrl+Return     { fullscreen-window; }
	Mod+Return      { maximize-column; }
	Mod+Ctrl+Return { spawn-sh "~/.config/niri/niri-maximize-helper"; }

	Mod+C { center-column; }

	// Center all fully visible columns on screen.
	//Mod+Ctrl+C { center-visible-columns; }

	Mod+Minus { set-column-width "-10%"; }
	Mod+Plus { set-column-width "+10%"; }

	Mod+Shift+Minus { set-window-height "-10%"; }
	Mod+Shift+Plus { set-window-height "+10%"; }

	Mod+V       { toggle-window-floating; }
	Ctrl+less   { switch-focus-between-floating-and-tiling; }

	Mod+W { toggle-column-tabbed-display; }

	Ctrl+Shift+4 { screenshot; }
	Ctrl+Shift+3 { screenshot-screen; }
	Alt+Shift+3  { screenshot-window; }

	Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

	Mod+Shift+E     { quit; }
	Ctrl+Alt+Delete { quit; }

	Mod+Shift+P { power-off-monitors; }
}

// Machine-specific work overrides. This repository is intentionally separate
// from the shared dotfiles repository and may be absent on non-work machines.
include optional=true "~/.dotfiles-work/.config/niri/work.kdl"
